<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Historical bin/obj output was committed before these folders were ignored.
      Keep all new compiler output in one clean, untracked location so WPF markup
      generation never consumes stale MainWindow.g.cs or *_Content.g.cs metadata.
      The project-name segment also prevents project-reference output collisions.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>

    <!--
      Moving BaseIntermediateOutputPath changes the SDK's automatic exclusions.
      Explicitly exclude every historical and current generated-output tree so
      tracked legacy WPF files can never be globbed as ordinary C# or XAML input.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)**\bin\**;$(MSBuildThisFileDirectory)**\obj\**;$(MSBuildThisFileDirectory)artifacts\**</DefaultItemExcludes>
    <DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);**\bin\**;**\obj\**;**\artifacts\**</DefaultExcludesInProjectFolder>
  </PropertyGroup>
</Project>
