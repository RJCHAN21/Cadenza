<Application x:Class="PianoPractice.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#0C1325" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#101A31" />
    <SolidColorBrush x:Key="CardBrush" Color="#151F37" />
    <SolidColorBrush x:Key="CardStrongBrush" Color="#1B2845" />
    <SolidColorBrush x:Key="BorderBrush" Color="#263657" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#EAC46B" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#B78D3E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#76D5D5" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F2EA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9BA9C6" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#667595" />
  </Application.Resources>
</Application>
