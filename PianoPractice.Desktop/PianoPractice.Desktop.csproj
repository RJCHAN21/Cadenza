<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PianoPractice.Desktop</RootNamespace>
    <AssemblyName>Cadenza</AssemblyName>
    <AssemblyTitle>Cadenza</AssemblyTitle>
    <Product>Cadenza</Product>
    <Description>A focused piano practice studio for listening, guided practice, and performance.</Description>
    <ApplicationIcon>Assets\Branding\Cadenza.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Verovio\**\*" CopyToOutputDirectory="Always" />
    <Content Include="Assets\Bravura\**\*" CopyToOutputDirectory="Always" />
    <Content Include="Packaging\Uninstall-Cadenza.ps1"
             CopyToOutputDirectory="PreserveNewest"
             TargetPath="Uninstall-Cadenza.ps1" />
  </ItemGroup>
</Project>
